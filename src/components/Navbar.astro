---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle';
import { currentClient } from '../config/clients';
---

<header class="fixed top-0 left-0 right-0 z-[100] glass border-b border-slate-200/20 dark:border-slate-800/20 transition-all duration-500">
	<div class="max-w-7xl mx-auto px-6 h-24 flex items-center justify-between">
		
		<!-- Logo -->
		<a href="#" class="flex items-center gap-3 group">
			<div 
				class="w-12 h-12 rounded-2xl flex items-center justify-center text-white shadow-premium hover:scale-110 transition-all duration-500"
				style={`background-color: ${currentClient.primaryColor};`}
			>
				<Icon name={currentClient.logoIcon} class="w-7 h-7" />
			</div>
			<div class="flex flex-col">
				<span class="text-2xl font-black text-slate-900 dark:text-white italic tracking-tighter leading-none">
					{currentClient.shortName}
				</span>
				<span class="text-[10px] font-black uppercase tracking-[0.3em] opacity-50 dark:text-white" style={`color: ${currentClient.primaryColor};`}>
					{currentClient.name.split(' ').slice(1).join(' ')}
				</span>
			</div>
		</a>

		<!-- Navegación Desktop -->
		<nav class="hidden md:flex items-center gap-10">
			<div class="flex items-center gap-10 text-xs font-black uppercase tracking-[0.2em] text-slate-500 dark:text-slate-400">
				<a href="#servicios" class="hover:text-slate-900 dark:hover:text-white transition-colors">Servicios</a>
				<a href="#sucursales" class="hover:text-slate-900 dark:hover:text-white transition-colors">Ubicación</a>
				<div class="h-4 w-px bg-slate-200 dark:bg-slate-800"></div>
				<ThemeToggle client:only="react" />
			</div>
			<a 
				href="#agendar" 
				class="text-white px-8 py-4 rounded-2xl font-black uppercase tracking-widest text-xs transition-all shadow-premium hover:shadow-premium-lg hover:-translate-y-0.5 active:scale-95"
				style={`background-color: ${currentClient.primaryColor};`}
			>
				Agendar Cita
			</a>
		</nav>

		<!-- Botón Móvil (Solo icono) -->
		<div class="md:hidden flex items-center gap-4">
			<ThemeToggle client:only="react" />
			<a 
				href="#agendar" 
				class="w-14 h-14 text-white rounded-[1.25rem] flex items-center justify-center shadow-premium active:scale-90 transition-all"
				style={`background-color: ${currentClient.primaryColor};`}
			>
				<Icon name="lucide:calendar" class="w-7 h-7" />
			</a>
		</div>

	</div>
</header>
